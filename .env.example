# =============================================================================
# Laboratorio de migración Oracle -> EDB Postgres Advanced Server (EPAS)
# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a Git.
#   cp .env.example .env
# =============================================================================

# ----------------------------- Oracle Database Free --------------------------
# Imagen multi-arquitectura (amd64/arm64 a partir de 23.5).
ORACLE_IMAGE=gvenzl/oracle-free:23-slim
ORACLE_PORT=1521
# Contraseña de SYS y SYSTEM. Cámbiala en cualquier entorno compartido.
ORACLE_PASSWORD=OracleLab_2026
# Usuario de aplicación que se crea en FREEPDB1.
ORACLE_APP_USER=ventas
ORACLE_APP_PASSWORD=VentasLab_2026
# PDB por defecto de Oracle Free. El script de grants la usa explícitamente.
ORACLE_PDB=FREEPDB1
# DSN que consume el ETL desde el host.
ORACLE_DSN=localhost:1521/FREEPDB1

# ------------------------------ EDB EPAS -------------------------------------
# OBLIGATORIO: imagen de EPAS a la que tengas acceso.
# El registro unificado de EDB requiere autenticación:
#   docker login docker.enterprisedb.com -u k8s
# Consulta docs/03-docker-oracle-edb.md para obtener el token y descubrir tags.
# El Dockerfile del laboratorio adapta la imagen oficial para ejecutarse sola.
EDB_IMAGE=docker.enterprisedb.com/k8s/edb-postgres-advanced:16.9-standard-ubi9
EDB_MAJOR=16
# Usuario del sistema operativo dentro de la imagen (normalmente postgres).
EDB_OS_USER=postgres
# En Apple Silicon, si la imagen no publica arm64, se usa emulación amd64.
EDB_PLATFORM=linux/amd64
EDB_PORT=5444
# Contraseña del superusuario enterprisedb.
EDB_PASSWORD=EdbLab_2026
# Usuario, base de datos y esquema de aplicación.
EDB_APP_USER=ventas
EDB_APP_PASSWORD=VentasLab_2026
EDB_DB=ventas
EDB_APP_SCHEMA=ventas
# Zona horaria del sistema operativo del contenedor (la BD usa UTC).
TZ=America/Mexico_City

# ------------------------------ ETL / Python ---------------------------------
EDB_HOST=localhost
EDB_SSL_MODE=prefer
# Lote de filas para COPY y cursores.
ETL_BATCH_SIZE=1000
# Directorio de reportes (relativo a la raíz del repositorio).
ETL_REPORT_DIR=migration/reports
